{
  "name": "klever-project",
  "version": "1.0.0",
  "description": "Клевер",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "images": "imagemin dist/images --out-dir=dist/images --plugin=mozjpeg --plugin=pngquant --plugin=svgo",
    "start": "concurrently \"npm run watch\" \"npm run dev\"",
    "server": "node server/server.js",
    "dev": "node --watch server/server.js",
    "watch": "webpack --mode development --watch",
    "build": "webpack --mode production && npm run images",
    "test": "npx playwright test",
    "test:local": "BASE_URL=http://localhost:80 npx playwright test",
    "test:prod": "BASE_URL=https://clover-go.ru npx playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dep-gen": "npx depcruise src --webpack-config webpack.config.js --output-type dot",
    "dep-all": "npm run dep-gen -s | dot -T svg > graphs/dependency-graph.svg",
    "dep-collapse-3": "npm run dep-gen -s -- --collapse 3| dot -T svg > graphs/collapse-3.svg",
    "dep-collapse-4": "npm run dep-gen -s -- --collapse 4| dot -T svg > graphs/collapse-4.svg",
    "dep": "npm run dep-all & npm run dep-collapse-3 && npm run dep-collapse-4",
    "focus": "npm run dep-gen -s -- --focus $npm_config_path | dot -T svg > graphs/$npm_config_path.svg",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontend-park-mail-ru/2026_1_VKernel_Team.git"
  },
  "keywords": [
    "klever",
    "classifieds",
    "express",
    "static-server"
  ],
  "author": "VKernel_Team",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/frontend-park-mail-ru/2026_1_VKernel_Team/issues"
  },
  "homepage": "https://github.com/frontend-park-mail-ru/2026_1_VKernel_Team#readme",
  "dependencies": {
    "dotenv": "^17.3.1",
    "handlebars": "^4.7.8",
    "lightweight-charts": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/handlebars": "^4.0.40",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "handlebars-loader": "^1.7.3",
    "html-webpack-plugin": "^5.6.6",
    "husky": "^9.1.7",
    "image-minimizer-webpack-plugin": "^5.0.0",
    "imagemin": "^9.0.1",
    "imagemin-cli": "^8.0.0",
    "imagemin-gifsicle": "^7.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-optipng": "^8.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-svgo": "^12.0.0",
    "lint-staged": "^16.4.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.8.1",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "svgo": "^4.0.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  }
}
