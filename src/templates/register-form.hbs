<div class="auth-container">
     <div class="auth-header">
        <a href="/" class="back-link">←</a>
        <h2>Вход в Клевер</h2>
    </div>
    
    <form id="register-form" class="auth-form" novalidate>
         <div class="form-group">
    <label for="name">Имя</label>
        <input 
            type="text" 
            id="name" 
            name="name" 
            placeholder="Введите имя"
            value="{{name}}"
            required
        >
        </div>
        
        <div class="form-group">
            <label for="email">Email</label>
            <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="Введите почту"
                value="{{email}}"
                required
            >           
        </div>
        
        <div class="form-group">
            <label for="password">Пароль</label>
            <input 
                type="password" 
                id="password" 
                name="password" 
                placeholder="Минимум 8 символов"
                required
            >
            <button type="button" class="toggle-password" data-target="confirm-password">
                <span class="eye-icon">
                    <img src="images/icons/Eye.jpeg" alt="Открытый глаз" class="eye">
                </span>
                <span class="eye-icon eye-slash" style="display: none;">
                    <img src="images/icons/Eye off.jpeg" alt="Закрытый глаз" class="eye">
                </span>
            </button>
        </div>
        
        <div class="form-group">
            <label for="confirm-password">Подтверждение пароля</label>
            <input 
                type="password" 
                id="confirm-password" 
                name="confirmPassword" 
                placeholder="Повторите пароль"
                required
            >
            <button type="button" class="toggle-password" data-target="confirm-password">
                <span class="eye-icon">
                    <img src="images/icons/Eye.jpeg" alt="Открытый глаз" class="eye">
                </span>
                <span class="eye-icon eye-slash" style="display: none;">
                    <img src="images/icons/Eye off.jpeg" alt="Закрытый глаз" class="eye">
                </span>
            </button>
        </div>
        
        <button type="submit" class="btn btn-primary btn-block">
            Зарегистрироваться
        </button>
    </form>
    
    <div class="auth-footer">
        Уже есть аккаунт? 
        <a href="#" onclick="App.showLogin(); return false;">Войти</a>
    </div>
</div>