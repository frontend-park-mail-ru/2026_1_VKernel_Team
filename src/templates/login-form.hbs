<div class="auth-container">
     <div class="auth-header">
        <a href="/" class="back-link">←</a>
        <h2>Вход в Клевер</h2>
    </div>
    <form id="login-form" class="auth-form" novalidate>
        <div class="form-group">
            <label for="email">Email</label>
            <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="Введите почту"
                value="{{email}}"
                required
            >
        </div>
        
        <div class="form-group">
            <label for="password">Пароль</label>
            <input 
                type="password" 
                id="password" 
                name="password" 
                placeholder="Введите пароль"
                required
            >
            <button type="button" class="toggle-password" data-target="confirm-password">
                <span class="eye-icon">
                    <img src="images/icons/Eye.jpeg" alt="Открытый глаз" class="eye">
                </span>
                <span class="eye-icon eye-slash" style="display: none;">
                    <img src="images/icons/Eye off.jpeg" alt="Закрытый глаз" class="eye">
                </span>
            </button>
        </div>
        <button type="submit" class="btn btn-primary btn-block">
            Войти
        </button>
        
    </form>
    
    <div class="auth-footer">
        Нет аккаунта? 
        <a href="#" onclick="App.showRegister(); return false;">Зарегистрироваться</a>
    </div>
</div>