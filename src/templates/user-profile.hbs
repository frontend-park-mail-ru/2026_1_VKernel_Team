<div class="profile-container">
    <div class="back-to-main">
        <a href="#" class="back-link" data-nav="/">←</a>
    </div>
    <nav class="main-nav">
        <a href="http://127.0.0.1:5501/public/index.html" class="nav-link">Главная</a>
        <a href="/profile" class="nav-link active">Профиль</a>
    </nav>
    <h2>Добро пожаловать, {{name}}!</h2>

    <div class="profile-card">
        <div class="profile-info">
            <p><strong>Email:</strong> {{email}}</p>
            <p><strong>Дата регистрации:</strong> {{registeredAt}}</p>
        </div>

        <div class="profile-actions">
            <button class="btn btn-danger" data-action="logout">
                Выйти из аккаунта
            </button>
        </div>
    </div>
</div>
