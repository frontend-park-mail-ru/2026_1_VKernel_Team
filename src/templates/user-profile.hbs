<div class="profile-container">
  <!-- Шапка профиля -->
  <header class="profile-header">
    <div class="avatar-wrapper">
      <img src="{{avatarUrl}}" alt="Аватар" class="avatar-img">
      <input type="file" id="avatarUpload" accept="image/*" hidden>
      <button type="button" id="changeAvatarBtn" class="avatar-btn" title="Сменить фото">📷</button>
    </div>
    
    <div class="user-info">
      <h1 class="username">{{user.name}}</h1>
      <div class="user-meta">
        <span class="rating">{{#if user.rating}}{{user.rating}}★{{else}}0.0 ★★★★★{{/if}}</span>
        <span class="reviews-link">Нет отзывов</span>
      </div>
      <div class="user-stats">
        <span class="stat">📦 Объявл.: {{user.ads_count}}</span>
        <span class="stat">❤️ Избранное: {{user.favorites_count}}</span>
        <span class="stat">🛒 Корзина: {{user.cart_count}}</span>
      </div>
    </div>
    
    <div class="header-actions">
      <button type="button" class="btn btn-secondary" id="editNameBtn">Редактировать имя</button>
      <button type="button" class="btn btn-danger logout-btn" id="logoutBtn">Выйти</button>
    </div>
  </header>

  <div class="profile-layout">
    <!-- Боковое меню -->
    <aside class="profile-sidebar">
      <nav class="sidebar-nav">
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab 'services')}}active{{/if}}" data-tab="services">Дополнительные услуги</a>
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab 'ads')}}active{{/if}}" data-tab="ads">Мои объявления <span class="badge">({{user.ads_count}})</span></a>
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab 'messages')}}active{{/if}}" data-tab="messages">Сообщения <span class="badge">({{user.messages_count}})</span></a>
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab 'cart')}}active{{/if}}" data-tab="cart">Корзина <span class="badge">({{user.cart_count}})</span></a>
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab 'favorites')}}active{{/if}}" data-tab="favorites">Избранное <span class="badge">({{user.favorites_count}})</span></a>
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab 'purchases')}}active{{/if}}" data-tab="purchases">Мои покупки</a>
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab 'wallet')}}active{{/if}}" data-tab="wallet">Кошелёк</a>
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab 'profile')}}active{{/if}}" data-tab="profile">Управление профилем</a>
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab 'settings')}}active{{/if}}" data-tab="settings">Настройки</a>
        <div class="sidebar-divider"></div>
        <a href="#" class="nav-item nav-item--logout" id="sidebarLogoutBtn">Выйти</a>
      </nav>
    </aside>

    <!-- Основной контент -->
    <main class="profile-content" id="tabContent">
      {{#if (eq activeTab 'ads')}}
        <h2 class="section-title">Мои объявления</h2>

        <!-- Табы фильтрации (по макету Figma) -->
        <div class="ads-tabs">
          <button class="tab-pill {{#if (eq adFilter 'all')}}tab-pill--active{{/if}}" data-filter="all">Все ({{adStats.all}})</button>
          <button class="tab-pill {{#if (eq adFilter 'active')}}tab-pill--active{{/if}}" data-filter="active">✓ Активные ({{adStats.active}})</button>
          <button class="tab-pill {{#if (eq adFilter 'completed')}}tab-pill--active{{/if}}" data-filter="completed">Завершённые ({{adStats.completed}})</button>
          <button class="tab-pill {{#if (eq adFilter 'inactive')}}tab-pill--active{{/if}}" data-filter="inactive">Неактивные ({{adStats.inactive}})</button>
          <button class="tab-pill {{#if (eq adFilter 'drafts')}}tab-pill--active{{/if}}" data-filter="drafts">Черновики ({{adStats.drafts}})</button>
        </div>

        <!-- Сетка объявлений / Empty State -->
        <div class="items-grid">
          {{#if ads.length}}
            {{#each ads}}
              <article class="item-card">
                <img src="{{this.image}}" alt="{{this.title}}">
                <div class="item-info">
                  <h3 class="item-title">{{this.title}}</h3>
                  <p class="price">{{this.price}} ₽</p>
                  <span class="location">{{this.location}}</span>
                </div>
              </article>
            {{/each}}
          {{else}}
            <div class="empty-state" style="grid-column: 1 / -1;">
              <div class="empty-placeholders">
                <div class="placeholder-card"></div>
                <div class="placeholder-card"></div>
              </div>
              <p>Все созданные объявления будут<br>отображаться на этой странице</p>
            </div>
          {{/if}}
        </div>
      {{else}}
        <div class="empty-state">Выберите раздел в меню для загрузки данных...</div>
      {{/if}}
    </main>
  </div>

  <!-- Модалка редактирования имени -->
  <div class="modal-overlay" id="editProfileModal">
    <div class="modal-content">
      <h3>Изменить имя</h3>
      <div class="form-group" style="margin: 1rem 0;">
        <input type="text" id="editNameInput" value="{{user.name}}" placeholder="Ваше имя" maxlength="50" style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 8px;">
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-primary" id="saveNameBtn">Сохранить</button>
        <button type="button" class="btn btn-secondary" id="cancelNameBtn">Отмена</button>
      </div>
    </div>
  </div>
</div>
