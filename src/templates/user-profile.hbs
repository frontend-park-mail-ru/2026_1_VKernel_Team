<div class="profile-container">
  <!-- Шапка профиля -->
  <header class="profile-header">
    <div class="avatar-wrapper">
      <img src="{{avatarUrl}}" alt="Аватар" class="avatar-img">
      <input type="file" id="avatarUpload" accept="image/*" hidden>
      <button type="button" id="changeAvatarBtn" class="avatar-btn" title="Сменить фото">📷</button>
    </div>
    <div class="user-info">
      <h1 class="username">{{user.name}}</h1>
      <p class="user-meta">На сайте с {{registeredAt}} • Рейтинг: {{#if user.rating}}{{user.rating}}★{{else}}—{{/if}}</p>
      <div class="user-stats">
        <span class="stat">📦 {{user.ads_count}} объявл.</span>
        <span class="stat">❤️ {{user.favorites_count}} в избранном</span>
        <span class="stat">🛒 {{user.cart_count}} в корзине</span>
      </div>
    </div>
    <div class="header-actions">
      <button type="button" class="btn btn-secondary" id="editNameBtn">Редактировать</button>
      <button type="button" class="btn btn-danger logout-btn" id="logoutBtn">Выйти</button>
    </div>
  </header>

  <div class="profile-layout">
    <!-- Боковое меню -->
    <aside class="profile-sidebar">
      <nav class="sidebar-nav">
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab "info")}}active{{/if}}" data-tab="info">Мой профиль</a>
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab "ads")}}active{{/if}}" data-tab="ads">Мои объявления</a>
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab "favorites")}}active{{/if}}" data-tab="favorites">Избранное</a>
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab "cart")}}active{{/if}}" data-tab="cart">Корзина</a>
        <a href="#" class="nav-item profile-tab-btn {{#if (eq activeTab "settings")}}active{{/if}}" data-tab="settings">Настройки</a>
      </nav>
    </aside>

    <!-- Основной контент -->
    <main class="profile-content" id="tabContent">
      <div class="empty-state">Выберите раздел для загрузки данных...</div>
    </main>
  </div>

  <!-- Модалка редактирования имени -->
  <div class="modal-overlay" id="editProfileModal">
    <div class="modal-content">
      <h3>Изменить имя</h3>
      <div class="form-group">
        <input type="text" id="editNameInput" value="{{user.name}}" placeholder="Ваше имя" maxlength="50">
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-primary" id="saveNameBtn">Сохранить</button>
        <button type="button" class="btn btn-secondary" id="cancelNameBtn">Отмена</button>
      </div>
    </div>
  </div>
</div>
