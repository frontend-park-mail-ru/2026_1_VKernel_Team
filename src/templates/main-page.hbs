<div class="main-container">
    <!-- НАВБАР -->
    <header class="header">
        <div class="header-content">
            <!-- Левая часть с иконками -->
            <div class="header-left">
                <div class="nav-icon">
                    <a href="#" class="nav-link">
                        <span class="icon">💼</span>
                        <span class="nav-text">Для бизнеса</span>
                    </a>
                </div>
                <div class="nav-icon">
                    <a href="#" class="nav-link">
                        <span class="icon">✉️</span>
                        <span class="nav-text">Сообщения</span>
                    </a>
                </div>
                <div class="nav-icon">
                    <a href="#" class="nav-link">
                        <span class="icon favorites">♡</span>
                        <span class="nav-text">Избранное</span>
                    </a>
                </div>
                <div class="nav-icon">
                    <a href="#" class="nav-link" data-nav="/cart">
                        <span class="icon">🛒</span>
                        <span class="nav-text">Корзина</span>
                    </a>
                </div>

            </div>

            <!-- Правая часть -->
            <div class="header-right">
                {{#if isAuthenticated}}
                    <button class="btn place-ad-btn" data-nav="/place-ad">Разместить объявление</button>
                <!--Нужна проверка в будущем на загрузку своей аватарки пользователем-->
                    <a href="">
                        <img src="{{avatarImageUrl}}" alt="Аватар" class="avatar">
                    </a>
                    <button class="btn btn-danger logout-btn" data-action="logout">
                        Выйти
                    </button>
                {{else}}
                    <button class="btn place-ad-btn" data-nav="/login">Разместить объявление</button>
                    <p>
                        <a href="#" class="nav-login" data-nav="/login">Войти</a>
                    </p>
                {{/if}}
            </div>
        </div>
    </header>

    <!-- ОСНОВНОЙ КОНТЕНТ -->
    <main class="main-content">
        <!-- Поисковый блок -->
        <div class="search-section">
            <!-- Лого и название в одной строке с поиском -->
            <div class="search-row">
                <div class="brand">
                    <a href="/" data-nav="/">
                        <img src="/images/logo/logo_clover2.jpeg" alt="Логотип" class="logo">
                    </a>
                </div>

                <div class="search-wrapper">
                    <input
                        type="text"
                        class="search-input"
                        placeholder="Поиск объявлений..."
                    >
                    <button class="btn place-ad-btn">Найти</button>
                </div>

                <div class="geo">
                    <span class="icon">📍</span>
                    <span class="city">Москва</span>
                </div>
            </div>
        </div>

        <!-- Здесь будет остальной контент -->
        <div class="content-grid">
            <!-- Левая колонка с контентом (9/12) -->
            <div class="main-column">
                <!-- Первая строка - 6 карточек -->
                <div class="cards-row">
                    <div class="category-card">
                        <span class="card-title">Авто</span>
                        <img src="images/product_category/car.jpeg" alt="Авто" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Недвижимость</span>
                        <img src="images/product_category/real_estate.jpeg" alt="Авто" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Работа</span>
                        <img src="images/product_category/work.jpeg" alt="Авто" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Одежда, обувь, аксессуары</span>
                        <img src="images/product_category/clothes.jpeg" alt="Авто" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Хобби и отдых</span>
                        <img src="images/product_category/rest.jpeg" alt="Авто" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Животные</span>
                        <img src="images/product_category/animals.jpeg" alt="Авто" class="product-image">
                    </div>
                </div>

                <!-- Вторая строка - 6 карточек -->
                <div class="cards-row">
                    <div class="category-card">
                        <span class="card-title">Электроника</span>
                        <img src="images/product_category/electronics.jpeg" alt="Авто" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Для дома и дачи</span>
                        <img src="images/product_category/home_garden.jpeg" alt="Авто" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Запчасти</span>
                        <img src="images/product_category/spare_parts.jpeg" alt="Авто" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Товары для детей</span>
                        <img src="images/product_category/for_children.jpeg" alt="Авто" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Красота и здоровье</span>
                        <img src="images/product_category/beauty.jpeg" alt="Авто" class="product-image">
                    </div>
                    <div class="category-card all-categories">
                        <span class="card-title">Все<br>категории</span>
                    </div>
                </div>

                <!-- Секция рекомендаций -->
                <div class="recommendations-section">
                    <h2 class="recommendations-title">Рекомендации для вас</h2>
                    <div class="recommendations-row">
                        {{#each recommendations}}
                        <div class="rec-card" data-id="{{id}}">
                            <div class="rec-card-image-container">
                                <img src="{{image}}" alt="{{title}}" class="rec-card-image">
                                <button class="rec-card-fav">♡</button>
                            </div>
                            <div class="rec-card-content">
                                <span class="rec-card-title">{{title}}</span>
                                <div class="rec-card-footer">
                                    <div class="rec-card-footer-info">
                                        <span class="rec-card-price">{{formattedPrice}}</span>
                                        <span class="rec-card-location">
                                            <span class="location-icon">📍</span>
                                            {{location}}
                                        </span>
                                    </div>
                                    <div class="rec-card-footer-actions">
                                        {{> cart-button productId=id}}
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>

            </div>

            <!-- Правая колонка с рекламой (3/12) -->
            <div class="ad-column">
                Рекламное место
            </div>
        </div>
    </main>
</div>
