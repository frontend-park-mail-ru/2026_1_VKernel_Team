<div class="main-container">
    <!-- НАВБАР -->
    <header class="header">
        <div class="header-content">
            <!-- Левая часть с иконками -->
            <div class="header-left">
                <div class="nav-icon">
                    <a href="#" class="nav-link">
                        <span class="icon">💼</span>
                        <span class="nav-text">Для бизнеса</span>
                    </a>
                </div>
                <div class="nav-icon">
                    <a href="#" class="nav-link">
                        <span class="icon">✉️</span>
                        <span class="nav-text">Сообщения</span>
                    </a>
                </div>
                <div class="nav-icon">
                    <a href="#" class="nav-link">
                        <span class="icon">❤️</span>                        
                        <span class="nav-text">Избранное</span>
                    </a>
                </div>
                <div class="nav-icon">
                    <a href="#" class="nav-link">
                        <span class="icon">🛒</span>
                        <span class="nav-text">Корзина</span>
                    </a>
                </div>
            </div>
            
            <!-- Правая часть -->
            <div class="header-right">
                <button class="btn place-ad-btn">Разместить объявление</button>
                
                {{#if isAuthenticated}}
                <!--Нужна проверка в будущем на загрузку своей аватарки пользователем-->
                    <img src="images/logo/avatar.jpeg" alt="Аватар" class="avatar">
                    {{!-- <div class="profile-icon">
                        <span class="icon">👤</span>
                    </div> --}}
                    <button class="btn btn-danger logout-btn" onclick="App.logout()">
                        Выйти
                    </button>
                {{else}}
                    {{!-- <div class="profile-icon" onclick="App.showLogin()">
                        <span class="icon">👤</span>
                    </div> --}}
                    <p>
                        <a href="#" onclick="App.showLogin(); return false;">
                            Вход и регистрация
                        </a>
                    </p>
                    <button class="btn btn-secondary logout-btn" onclick="App.showLogin()">
                        Войти
                    </button>
                {{/if}}
            </div>
        </div>
    </header>

    <!-- ОСНОВНОЙ КОНТЕНТ -->
    <main class="main-content">
        <!-- Поисковый блок -->
        <div class="search-section">
            <div class="search-row">
                <div class="brand">
                    {{!-- <span class="logo">🍀</span> --}}
                    <img src="images/logo/logo.jpeg" alt="Логотип" class="logo">
                    <span class="brand-name">Клевер</span>
                </div>

                <div class="search-wrapper">
                    <input 
                        type="text" 
                        class="search-input" 
                        placeholder="Поиск объявлений..."
                    >
                    <button class="btn place-ad-btn">Найти</button>
                </div>

                <div class="geo">
                    <span class="icon">📍</span>
                    <span class="city">Москва</span>
                </div>
            </div>
        </div>

        <div class="content-grid">
            <div class="main-column">
                <div class="cards-row">
                    <div class="category-card">
                        <span class="card-title">Авто</span>
                        <img src="images/product_category/car.jpeg" alt="Авто" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Недвижимость</span>
                        <img src="images/product_category/real_estate.jpeg" alt="Недвижимость" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Работа</span>
                        <img src="images/product_category/work.jpeg" alt="Работа" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Одежда, обувь, аксессуары</span>
                        <img src="images/product_category/clothes.jpeg" alt="Одежда" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Хобби и отдых</span>
                        <img src="images/product_category/rest.jpeg" alt="Отдых" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Животные</span>
                        <img src="images/product_category/animals.jpeg" alt="Животные" class="product-image">
                    </div>
                </div>

                <div class="cards-row">
                    <div class="category-card">
                        <span class="card-title">Электроника</span>
                        <img src="images/product_category/electronics.jpeg" alt="Электроника" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Для дома и дачи</span>
                        <img src="images/product_category/home_garden.jpeg" alt="Для дома" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Запчасти</span>
                        <img src="images/product_category/spare_parts.jpeg" alt="Запчасти" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Товары для детей</span>
                        <img src="images/product_category/for_children.jpeg" alt="Для детей" class="product-image">
                    </div>
                    <div class="category-card">
                        <span class="card-title">Красота и здоровье</span>
                        <img src="images/product_category/beauty.jpeg" alt="Красота" class="product-image">
                    </div>
                    <div class="category-card all-categories">
                        <span class="card-title">Все категории</span>
                    </div>
                </div>

                <div class="recommendations-section">
                    <h2 class="recommendations-title">Рекомендации для вас</h2>
                    <div class="recommendations-row">
                        {{#each recommendations}}
                        <div class="rec-card" data-id="{{id}}">
                            <img src="{{image}}" alt="{{title}}" class="rec-card-image">
                            <div class="rec-card-content">
                                <div class="rec-card-info">
                                    <span class="rec-card-title">{{title}}</span>
                                    <span class="rec-card-price">{{price}}</span>
                                    <span class="rec-card-location">
                                        <span class="location-icon">📍</span>
                                        {{location}}
                                    </span>
                                </div>
                                <div class="rec-card-actions">
                                    <button class="rec-card-fav">❤️</button>
                                    <button class="rec-card-cart">🛒</button>
                                    <p>{{favorites}} просмотров</p>
                                </div>
                            </div>
                        </div>
                        {{else}}
                        <div class="rec-card-placeholder">
                            <p>Нет рекомендаций</p>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>
            
            <div class="ad-column">
                Рекламное место
            </div>
        </div>
    </main>
</div>
