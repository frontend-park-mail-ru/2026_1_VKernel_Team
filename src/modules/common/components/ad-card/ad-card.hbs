<div class="rec-card{{#if archived}} rec-card--archived{{/if}}" data-id="{{id}}">
    <div class="rec-card-image-container">
        <img src="{{image}}" alt="{{title}}" class="rec-card-image">
        {{#unless archived}}

        <button class="rec-card-fav {{#if isFavorite}}rec-card-fav--active{{/if}}" data-fav-id="{{id}}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
        </button>
        {{/unless}}
    </div>
    <div class="rec-card-content">
        <span class="rec-card-title">{{title}}</span>
        <div class="rec-card-footer">
            <div class="rec-card-footer-info">
                <span class="rec-card-price">{{formattedPrice}}</span>
                <span class="rec-card-location">
                    <span class="location-icon">📍</span>
                    <span class="rec-card-location-text">{{location}}</span>
                </span>
            </div>
            {{#if showCartButton}}
            {{#unless isOwn}}
            <div class="rec-card-footer-actions">
                {{> cart/components/cart-button/cart-button productId=id}}
            </div>
            {{/unless}}
            {{/if}}
            {{#if showEditButton}}
            <div class="rec-card-footer-actions rec-card-footer-actions--row">
                <button class="rec-card-edit" data-edit-id="{{id}}" title="Редактировать">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                </button>
                <button class="rec-card-close" data-close-id="{{id}}" data-close-title="{{title}}" title="Закрыть объявление">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        <line x1="10" y1="11" x2="10" y2="17"/>
                        <line x1="14" y1="11" x2="14" y2="17"/>
                    </svg>
                </button>
            </div>
            {{/if}}
        </div>
    </div>
</div>
