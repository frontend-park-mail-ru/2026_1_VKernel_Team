<div class="header">
    <div class="header-content">
        <div class="header-left">
            <div class="nav-icon">
                <a href="#" class="nav-link">
                    <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
                    <span class="nav-text">Платные услуги</span>
                </a>
            </div>
            <div class="nav-icon">
                <a href="/chats" class="nav-link nav-link--with-badge" data-nav="/chats">
                    <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span>
                    <span class="nav-text">Сообщения</span>
                    {{#if (gt unreadChatsCount 0)}}
                        <span class="nav-badge">{{unreadChatsCount}}</span>
                    {{/if}}
                </a>
            </div>
            <div class="nav-icon">
                <a href="#" class="nav-link">
                    <span class="icon favorites"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span>
                    <span class="nav-text">Избранное</span>
                </a>
            </div>
            <div class="nav-icon">
                <a href="#" class="nav-link cart-active" data-nav="/cart">
                    <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></span>
                    <span class="nav-text">Корзина</span>
                </a>
            </div>
            {{#if isStaff}}
                <div class="nav-icon">
                    <a href="/support/stats" class="nav-link" data-nav="/support/stats">
                        <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg></span>
                        <span class="nav-text">Статистика</span>
                    </a>
                </div>
            {{/if}}
        </div>
        <div class="header-right">
            {{#if isAuthenticated}}
                <button class="btn place-ad-btn" data-nav="/place-ad">Разместить объявление</button>
                <a href="/profile" data-nav="/profile">
                    <img src="{{avatarUrl user.avatar user.avatar_path}}" alt="Аватар" class="avatar">
                </a>
            {{else}}
                <button class="btn place-ad-btn" data-nav="/login">Разместить объявление</button>
                <p>
                    <a href="#" class="nav-login" data-nav="/login">Войти</a>
                </p>
            {{/if}}
        </div>
    </div>
</div>
 