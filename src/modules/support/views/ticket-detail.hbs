<div class="support-detail">
    <button class="support-btn support-btn--back" id="support-back-btn">&larr; Назад</button>

    <div class="support-detail__header">
        <span class="support-ticket-card__category support-ticket-card__category--{{ticket.category}}">
            {{#if (eq ticket.category "bug")}}Баг{{/if}}
            {{#if (eq ticket.category "suggestion")}}Предложение{{/if}}
            {{#if (eq ticket.category "complaint")}}Жалоба{{/if}}
        </span>
        <span class="support-ticket-card__status support-ticket-card__status--{{ticket.status}}">
            {{#if (eq ticket.status "open")}}Открыто{{/if}}
            {{#if (eq ticket.status "in_progress")}}В работе{{/if}}
            {{#if (eq ticket.status "closed")}}Закрыто{{/if}}
        </span>
    </div>

    <h3 class="support-detail__title">{{ticket.title}}</h3>

    <p class="support-detail__description">{{ticket.description}}</p>

    <div class="support-detail__meta">
        Создано: {{formatDate ticket.created_at}}
    </div>

    {{#if (eq ticket.status "open")}}
        <button class="support-btn support-btn--secondary" id="support-edit-btn" data-ticket-id="{{ticket.id}}">
            Редактировать
        </button>
    {{/if}}

    <div id="chat-container"></div>
</div>
