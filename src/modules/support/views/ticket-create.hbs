<div class="support-create">
    <button class="support-btn support-btn--back" id="support-back-btn">&larr; Назад</button>

    <h3 class="support-create__title">Новое обращение</h3>

    <form class="support-create__form" id="support-create-form">
        <div class="support-form-group">
            <label class="support-form-label" for="ticket-category">Категория</label>
            <select class="support-form-select" id="ticket-category" name="category" required>
                <option value="">Выберите категорию</option>
                <option value="bug">Баг</option>
                <option value="suggestion">Предложение</option>
                <option value="complaint">Жалоба</option>
            </select>
            <span class="support-form-error" id="category-error"></span>
        </div>

        <div class="support-form-group">
            <label class="support-form-label" for="ticket-title">Заголовок</label>
            <input
                class="support-form-input"
                type="text"
                id="ticket-title"
                name="title"
                maxlength="255"
                placeholder="Кратко опишите проблему"
                required
            />
            <span class="support-form-error" id="title-error"></span>
        </div>

        <div class="support-form-group">
            <label class="support-form-label" for="ticket-description">Описание</label>
            <textarea
                class="support-form-textarea"
                id="ticket-description"
                name="description"
                rows="5"
                placeholder="Подробно опишите проблему"
                required
            ></textarea>
            <span class="support-form-error" id="description-error"></span>
        </div>

        <button class="support-btn support-btn--primary support-btn--full" type="submit" id="support-submit-btn">
            Отправить
        </button>
    </form>
</div>
