<div class="admin-table-wrapper">
    {{#if tickets.length}}
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Автор</th>
                    <th>Заголовок</th>
                    <th>Категория</th>
                    <th>Статус</th>
                    <th>Создано</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each tickets}}
                    <tr class="admin-table__row" data-ticket-id="{{this.id}}">
                        <td>#{{this.id}}</td>
                        <td>{{this.user_id}}</td>
                        <td class="admin-table__title">{{this.title}}</td>
                        <td>
                            <span class="admin-badge admin-badge--{{this.category}}">
                                {{#if (eq this.category "bug")}}Баг{{/if}}
                                {{#if (eq this.category "suggestion")}}Предложение{{/if}}
                                {{#if (eq this.category "complaint")}}Жалоба{{/if}}
                            </span>
                        </td>
                        <td>
                            <select class="admin-status-select admin-status-select--{{this.status}}" data-ticket-id="{{this.id}}">
                                <option value="open" {{#if (eq this.status "open")}}selected{{/if}}>Открыто</option>
                                <option value="in_progress" {{#if (eq this.status "in_progress")}}selected{{/if}}>В работе</option>
                                <option value="closed" {{#if (eq this.status "closed")}}selected{{/if}}>Закрыто</option>
                            </select>
                        </td>
                        <td>{{formatDate this.created_at}}</td>
                        <td>
                            <button class="admin-chat-btn" data-ticket-id="{{this.id}}" title="Открыть чат">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                </svg>
                                Чат
                            </button>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <div class="admin-table__empty">Обращений не найдено</div>
    {{/if}}
</div>
