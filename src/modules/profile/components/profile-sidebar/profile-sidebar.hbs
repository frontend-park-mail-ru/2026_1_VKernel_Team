<div class="profile-info-card">
    <div class="profile-info-card__main">
        <div class="profile-info-card__section">
            <div class="profile-info-card__name-row">
                <h2 class="profile-info-card__name">{{user.name}}</h2>
                <button class="profile-info-card__edit-btn" data-action="open-edit-name" title="Изменить имя" aria-label="Изменить имя">{{{icon "edit"}}}</button>
            </div>
            {{#if user.email}}
                <p class="profile-info-card__email">{{user.email}}</p>
            {{/if}}
        </div>

        <div class="profile-info-card__section">
            <span class="profile-info-card__stat">
                <span class="profile-info-card__rating-star">{{{icon "star-filled"}}}</span>
                Рейтинг: <strong>{{#if user.rating}}{{user.rating}}{{else}}0{{/if}}</strong>
                {{#if user.id}}
                    <a class="profile-info-card__rating-link"
                       href="/seller/{{user.id}}#reviews"
                       title="Посмотреть все отзывы">
                        Посмотреть
                    </a>
                {{/if}}
            </span>
            {{#if totalAdsCount}}
                <span class="profile-info-card__stat">
                    Объявлений: <strong>{{totalAdsCount}}</strong>
                </span>
            {{/if}}
        </div>

        <div class="profile-info-card__section">
            <span class="profile-info-card__balance">Баланс: <strong>{{#if walletBalance}}{{walletBalance}} ₽{{else}}0 ₽{{/if}}</strong></span>
        </div>

        <span class="profile-info-card__date">На Клевере с {{formatDateOnly user.created_at}}</span>
    </div>

    {{> profile/components/profile-avatar/profile-avatar user=user }}
</div>

<button class="profile-nav-toggle" type="button" data-action="toggle-profile-nav" aria-label="Открыть меню">
    <span class="profile-nav-toggle__icon" aria-hidden="true">
        <span class="profile-nav-toggle__bar"></span>
        <span class="profile-nav-toggle__bar"></span>
        <span class="profile-nav-toggle__bar"></span>
    </span>
    <span class="profile-nav-toggle__label">Меню</span>
</button>

<div class="profile-nav-overlay" data-action="close-profile-nav"></div>

<nav class="profile-nav">
    <button class="profile-nav__close" type="button" data-action="close-profile-nav" aria-label="Закрыть меню">×</button>

    {{#each (array 'ads' 'pending' 'favorites' 'cart' 'messages' 'purchases' 'reviews' 'wallet' 'paid_services' 'settings') as |tab|}}
        <button
            class="profile-nav-item {{#eq ../currentTab tab}}active{{/eq}}"
            data-tab="{{tab}}"
        >
            <span class="nav-label">{{labelForTab tab}}</span>
            {{#if (gt (lookup ../user (concat tab '_count')) 0)}}
                <span class="nav-badge">{{lookup ../user (concat tab '_count')}}</span>
            {{/if}}
        </button>
    {{/each}}

    <div class="nav-divider"></div>

    <button class="profile-nav-item logout-item" data-action="logout">
        <span class="nav-label">Выйти</span>
    </button>
</nav>
