<aside class="profile-sidebar">
  <nav class="profile-nav">
    {{#each (array 'info' 'ads' 'favorites' 'cart' 'messages' 'purchases' 'wallet' 'settings') as |tab|}}
      <button 
        class="profile-nav-item {{#eq ../currentTab tab}}active{{/eq}}" 
        data-tab="{{tab}}"
      >
        <span class="nav-icon">{{iconForTab tab}}</span>
        <span class="nav-label">{{labelForTab tab}}</span>
        
        {{!-- Используем lookup для подтягивания счетчиков (ads_count, favorites_count и т.д.) --}}
        {{#if (gt (lookup ../user (concat tab '_count')) 0)}}
          <span class="nav-badge">{{lookup ../user (concat tab '_count')}}</span>
        {{/if}}
      </button>
    {{/each}}
    
    <div class="nav-divider"></div>
    
    <button class="profile-nav-item logout-item" data-action="logout">
      <span class="nav-icon">🚪</span>
      <span class="nav-label">Выйти</span>
    </button>
  </nav>
</aside>
