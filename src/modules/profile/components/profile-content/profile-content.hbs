<div class="profile-tab-content">
  {{#if (eq currentTab 'info')}}
    <h2 class="section-title">Личные данные</h2>

    <div class="profile-card">
      {{!-- Аватарка --}}
      {{> profile/components/profile-avatar/profile-avatar user=user }}
      
      <div class="profile-details">
        {{!-- Имя --}}
        <div class="detail-row">
          <span class="detail-label">Имя:</span>
          <span class="detail-value">{{user.name}}</span>
          <button class="btn-edit" data-action="open-edit-name">Изменить</button>
        </div>

        {{!-- Email --}}
        <div class="detail-row">
          <span class="detail-label">Email:</span>
          <span class="detail-value">{{user.email}}</span>
        </div>

        {{!-- Рейтинг --}}
        <div class="detail-row">
          <span class="detail-label">Рейтинг:</span>
          <span class="detail-value">{{#if user.rating}}{{user.rating}}{{else}}0{{/if}}</span>
        </div>
        
        {{!-- Дата регистрации --}}
        <div class="detail-row">
          <span class="detail-label">На Клевере с:</span>
          <span class="detail-value">{{formatDate user.created_at}}</span>
        </div>
      </div>
    </div>
  {{/if}}

  {{#if (eq currentTab 'ads')}}
      <h2 class="section-title">Мои объявления</h2>
      {{#if userAds.length}}
          <div class="recommendations-row">
              {{#each userAds}}
                  <div class="rec-card" data-id="{{id}}">
                      <div class="rec-card-image-container">
                          <img src="{{image}}" alt="{{title}}" class="rec-card-image">
                          <button class="rec-card-fav">♡</button>
                      </div>
                      <div class="rec-card-content">
                          <span class="rec-card-title">{{title}}</span>
                          <div class="rec-card-footer">
                              <div class="rec-card-footer-info">
                                  <span class="rec-card-price">{{formattedPrice}}</span>
                                  <span class="rec-card-location">
                                      <span class="location-icon">📍</span>
                                      {{location}}
                                  </span>
                              </div>
                              <div class="rec-card-footer-actions">
                                <button class="rec-card-edit" data-edit-id="{{id}}" title="Редактировать">
                                  ✏️
                                </button>
                              </div>
                          </div>
                      </div>
                  </div>
              {{/each}}
          </div>
      {{else}}
          <p class="seller-ads-empty">У вас пока нет объявлений. 
              <a href="#" data-nav="/place-ad">Создать объявление</a>
          </p>
      {{/if}}
  {{/if}}
</div>
