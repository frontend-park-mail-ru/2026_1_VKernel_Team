<div class="profile-tab-content">

  {{#if (eq currentTab 'ads')}}
    <h2 class="profile-section-title">Мои объявления</h2>

    <div class="profile-ad-tabs">
        <button class="profile-ad-tab profile-ad-tab--active" data-profile-ad-tab="active">
            Активные ({{activeAdsCount}})
        </button>
        <button class="profile-ad-tab" data-profile-ad-tab="archived">
            Неактивные ({{archivedAdsCount}})
        </button>
    </div>

    <div data-profile-ad-content="active">
        {{#if activeAds.length}}
            <div class="profile-ads-row">
                {{#each activeAds}}
                    {{> profile/components/profile-ad-card/profile-ad-card this}}
                {{/each}}
            </div>
        {{else}}
            <p class="profile-ads-empty">У вас нет активных объявлений.
                <a href="#" data-nav="/place-ad">Создать объявление</a>
            </p>
        {{/if}}
    </div>

    <div data-profile-ad-content="archived" style="display: none;">
        {{#if archivedAds.length}}
            <div class="profile-ads-row">
                {{#each archivedAds}}
                    {{> profile/components/profile-ad-card/profile-ad-card this archived=true}}
                {{/each}}
            </div>
        {{else}}
            <p class="profile-ads-empty">Нет неактивных объявлений</p>
        {{/if}}
    </div>
  {{/if}}

    {{#if (eq currentTab 'favorites')}}
        <h2 class="profile-section-title">Избранное</h2>
    {{#if favorites.length}}
        <div class="recommendations-row">
            {{#each favorites}}
                {{> profile/components/favorite-card/favorite-card this}}
            {{/each}}
        </div>
    {{else}}
        <p class="profile-ads-empty">У вас пока нет избранных объявлений</p>
    {{/if}}
  {{/if}}

  {{#if (eq currentTab 'cart')}}
    <p class="profile-section-placeholder">Корзина — в разработке</p>
  {{/if}}

  {{#if (eq currentTab 'messages')}}
    <p class="profile-section-placeholder">Сообщения — в разработке</p>
  {{/if}}

  {{#if (eq currentTab 'purchases')}}
    <h2 class="profile-section-title">Мои покупки</h2>

    {{#if purchases.length}}
        <div class="recommendations-row">
            {{#each purchases}}
                <div class="rec-card rec-card--purchase" data-id="{{this.product_id}}">
                    <div class="rec-card-image-container">
                        <img src="{{this.imageUrl}}" alt="{{this.title}}" class="rec-card-image">
                    </div>
                    <div class="rec-card-content">
                        <span class="rec-card-title">{{this.title}}</span>
                        <div class="rec-card-footer">
                            <div class="rec-card-footer-info">
                                <span class="rec-card-price">{{this.formattedPrice}}</span>
                                <span class="rec-card-location">
                                    <span class="location-icon">{{{icon "pin"}}}</span>
                                    <span class="rec-card-location-text">{{this.location}}</span>
                                </span>
                            </div>
                        </div>
                        <span class="rec-card-date">Куплено: {{this.purchasedDate}}</span>
                    </div>
                </div>
            {{/each}}
        </div>
    {{else}}
        <p class="profile-ads-empty">У вас пока нет покупок</p>
    {{/if}}
  {{/if}}

{{#if (eq currentTab 'paid_services')}}
    {{> promotion/components/history-tab/history-tab }}
{{/if}}

  {{#if (eq currentTab 'wallet')}}
    {{> wallet/components/wallet-tab/wallet-tab }}
  {{/if}}

  {{#if (eq currentTab 'settings')}}
    <p class="profile-section-placeholder">Настройки — в разработке</p>
  {{/if}}

</div>
