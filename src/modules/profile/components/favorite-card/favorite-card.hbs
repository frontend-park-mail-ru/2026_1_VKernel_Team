<div class="rec-card rec-card--favorite" data-id="{{id}}">
    <div class="rec-card-image-container">
        <img src="{{image}}" alt="{{title}}" class="rec-card-image">
        {{!-- Сердечко всегда активное (закрашенное) на этой вкладке --}}
        <button class="rec-card-fav rec-card-fav--active" data-remove-fav-id="{{id}}" title="Убрать из избранного">
            ♥
        </button>
    </div>
    <div class="rec-card-content">
        <span class="rec-card-title">{{title}}</span>
        <div class="rec-card-footer">
            <div class="rec-card-footer-info">
                <span class="rec-card-price">{{formattedPrice}}</span>
                <span class="rec-card-location">
                    <span class="location-icon">📍</span>
                    <span class="rec-card-location-text">{{location}}</span>
                </span>
            </div>
            
            {{!-- Кнопка корзины (если товар не свой) --}}
            {{#unless isOwn}}
            <div class="rec-card-footer-actions">
                {{> cart/components/cart-button/cart-button productId=id}}
            </div>
            {{/unless}}
        </div>
    </div>
</div>
