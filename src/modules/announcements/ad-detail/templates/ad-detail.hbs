<div class="main-container ad-detail-page">
    <!-- ОСНОВНОЙ КОНТЕНТ -->
    <main class="main-content">
        <!-- Поисковый блок -->
        <div class="search-section">
            <!-- Лого и название в одной строке с поиском -->
            <div class="search-row">
                <div class="brand">
                    <a href="/" data-nav="/">
                        <img src="/images/logo/logo_clover2.jpeg" alt="Логотип" class="logo">
                    </a>
                </div>

                <!-- Кнопка "Все категории" -->
                <button class="btn-categories" data-action="show-categories">
                    Все категории
                </button>

                <div class="search-wrapper">
                    <input 
                        type="text" 
                        class="search-input" 
                        id="globalSearchInput"
                        placeholder="Поиск объявлений..."
                    >
                    <button class="btn place-ad-btn" id="globalSearchBtn">Найти</button>
                </div>
            </div>
        </div>

        <!-- Здесь будет остальной контент -->
        <div class="content-grid">
            <!-- Левая колонка (9/12) -->
            <div class="main-column">
                <!-- Название товара -->
                <div class="ad-title-section">
                    <button class="back-btn" data-action="back"><span class="back-btn__icon">{{{icon "arrow-left"}}}</span><span>Назад</span></button>
                    <h1 class="ad-title">{{title}}</h1>
                </div>

                <!-- ГАЛЕРЕЯ ФОТО -->
                <div class="ad-gallery-section">
                    <div class="ad-gallery-container">
                        <!-- Главное фото -->
                        <div class="ad-main-photo-wrapper">
                            <img 
                                src="{{mainPhoto}}" 
                                alt="{{title}}" 
                                class="ad-main-photo" 
                                id="mainPhoto"
                            >
                            {{#if hasMultiplePhotos}}
                            <button class="gallery-nav prev" data-gallery-prev aria-label="Предыдущее фото">{{{icon "chevron-left"}}}</button>
                            <button class="gallery-nav next" data-gallery-next aria-label="Следующее фото">{{{icon "chevron-right"}}}</button>
                            {{/if}}
                        </div>
                        
                        <!-- Миниатюры справа (вертикальные) -->
                        {{#if hasMultiplePhotos}}
                        <div class="ad-thumbnails-vertical">
                            {{#each allPhotos}}
                            <div class="thumbnail-vertical-wrapper {{#if @first}}active{{/if}}" data-thumb-index="{{@index}}">
                                <img 
                                    src="{{this}}" 
                                    alt="Фото" 
                                    class="thumbnail-vertical"
                                    data-thumbnail="{{this}}"
                                >
                            </div>
                            {{/each}}
                        </div>
                        {{/if}}
                    </div>
                </div>

                <div class="views">
                    <span>Размещено: {{formattedDate}}</span>
                    <span>Просмотры: {{views_count}}</span>
                </div>

                <!-- ОПИСАНИЕ ТОВАРА -->
                <div class="ad-description-section">
                    <h2 class="section-title">Описание</h2>
                    <div class="ad-description {{#if isDescriptionLong}}collapsed{{/if}}" id="adDescription">
                        <p>{{description}}</p>
                    </div>
                    {{#if isDescriptionLong}}
                    <button class="btn-show-more" data-action="toggle-description">
                        <span class="show-more-text">Показать полностью</span>
                        <span class="show-less-text" style="display: none;">Свернуть</span>
                    </button>
                    {{/if}}
                </div>

                <!-- ХАРАКТЕРИСТИКИ (2 колонки по 4 строки) -->
                <div class="ad-attributes-section">
                    <h2 class="section-title">Характеристики</h2>
                    <div class="attributes-grid">
                        {{#each attributes}}
                            <div class="attribute-item">
                                <span class="attribute-name">{{name}}:</span>
                                <span class="attribute-value">{{value}}</span>
                            </div>
                        {{/each}}
                    </div>
                </div>

                <!-- МЕСТОПОЛОЖЕНИЕ ПРОДАВЦА -->
                <div class="ad-location-section">
                    <h2 class="section-title">Местоположение</h2>
                    <div class="location-info">
                        {{!-- <span class="location-icon">📍</span> --}}
                        <div class="location-details">
                            <div class="location-address">{{location}}</div>
                            <div class="seller-name" 
                                data-action="go-to-seller" 
                                data-seller-id="{{sellerId}}" 
                                data-is-owner="{{isOwner}}"
                                style="cursor: pointer;">Продавец: <a>{{sellerName}}</a>
                            </div>
                            <div class="seller-since">Зарегистрирован: {{sellerSince}}</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Правая колонка (3/12) -->
            <div class="ad-right">
                <!-- Карточка действий (оформление заказа) -->
                <div class="action-card">
                    <!-- ЦЕНА + ИЗБРАННОЕ (в одной строке) -->
                    <div class="price-row">
                        <div class="price-block">
                            <div class="current-price">{{formattedPrice}}</div>
                            {{#if oldPrice}}
                                <div class="old-price">{{oldPrice}} ₽</div>
                            {{/if}}
                        </div>
                        <button class="favorite-circle-btn {{#if isFavorite}}active{{/if}}" data-action="add-to-favorites" title="В избранное" aria-label="В избранное">
                            <svg class="heart-icon" width="22" height="22" viewBox="0 0 24 24" fill="{{#if isFavorite}}currentColor{{else}}none{{/if}}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                        </button>
                    </div>

                    <!-- КНОПКИ ДЕЙСТВИЙ -->
                    <div class="action-buttons">
                        {{#if isOwner}}
                        <button class="action-btn edit-btn" data-action="edit-ad" data-ad-id="{{id}}">
                            Редактировать
                        </button>
                        <div class="ad-promotion-section">
                            <h3 class="ad-promotion-title">Продвижение</h3>
                            <div id="adPromotionStatus"></div>
                            <button class="action-btn promote-btn" data-action="promote-ad" data-promote-ad-id="{{id}}">
                                Продвигать
                            </button>
                        </div>
                        {{else}}
                        {{#unless isClosed}}
                        <button class="action-btn cart-btn" data-action="add-to-cart" data-cart-add="{{id}}">
                            <span class="cart-btn-label">Добавить в корзину</span>
                        </button>
                        <button class="action-btn buy-btn" data-action="message-seller">
                            Написать продавцу
                        </button>
                        {{/unless}}
                        {{/if}}
                    </div>

                    <!-- ПРОДАВЕЦ (кликабельный блок) -->
                    <div class="seller-card">
                        <div class="seller-avatar" data-action="go-to-seller" data-seller-id="{{sellerId}}" data-is-owner="{{isOwner}}">
                            <img src="{{sellerAvatar}}" alt="{{sellerName}}">
                        </div>
                        <div class="seller-info">
                            <div class="seller-name" data-action="go-to-seller" data-seller-id="{{sellerId}}" data-is-owner="{{isOwner}}">
                                {{sellerName}}
                            </div>
                            <div class="seller-rating">
                                <span class="stars">{{{sellerStars}}}</span>
                                <span class="rating-value">{{sellerRating}}</span>
                            </div>
                            <button class="all-reviews-btn" data-action="all-reviews" data-seller-id="{{sellerId}}">
                                <span>Все отзывы</span><span class="all-reviews-btn__icon">{{{icon "arrow-right"}}}</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="ad-column">
                    Рекламное место
                </div>
            </div>
        </div>
    </main>
</div>
