<div class="main-container ad-detail-page">
    <!-- ОСНОВНОЙ КОНТЕНТ -->
    <main class="main-content">
        <!-- Поисковый блок -->
        <div class="search-section">
            <!-- Лого и название в одной строке с поиском -->
            <div class="search-row">
                <div class="brand">
                    <a href="/" data-nav="/">
                        <img src="/images/logo/logo_clover2.png" alt="Логотип" class="logo">
                    </a>
                </div>

                <div class="search-wrapper">
                    <input 
                        type="text" 
                        class="search-input" 
                        id="globalSearchInput"
                        placeholder="Поиск объявлений..."
                    >
                    <button class="btn place-ad-btn" id="globalSearchBtn">Найти</button>
                </div>
            </div>
        </div>

        <!-- Здесь будет остальной контент -->
        <div class="content-grid">
            <!-- Левая колонка (9/12) -->
            <div class="main-column">
                <!-- Название товара -->
                <div class="ad-title-section">
                    <h1 class="ad-title">{{title}}</h1>
                </div>

                <!-- ГАЛЕРЕЯ ФОТО -->
                <div class="ad-gallery-section">
                    <div class="ad-gallery-container">
                        <!-- Главное фото -->
                        <div class="ad-main-photo-wrapper">
                            <img 
                                src="{{mainPhoto}}" 
                                alt="{{title}}" 
                                class="ad-main-photo" 
                                id="mainPhoto"
                            >
                            {{#if hasMultiplePhotos}}
                            <button class="gallery-nav prev" data-gallery-prev aria-label="Предыдущее">{{{icon "chevron-left"}}}</button>
                            <button class="gallery-nav next" data-gallery-next aria-label="Следующее">{{{icon "chevron-right"}}}</button>
                            {{/if}}
                        </div>
                        
                        <!-- Миниатюры справа (вертикальные) -->
                        {{#if hasMultiplePhotos}}
                        <div class="ad-thumbnails-vertical">
                            {{#each allPhotos}}
                            <div class="thumbnail-vertical-wrapper {{#if @first}}active{{/if}}" data-thumb-index="{{@index}}">
                                <img 
                                    src="{{this}}" 
                                    alt="Фото" 
                                    class="thumbnail-vertical"
                                    data-thumbnail="{{this}}"
                                >
                            </div>
                            {{/each}}
                        </div>
                        {{/if}}
                    </div>
                </div>

                <!-- ОПИСАНИЕ ТОВАРА -->
                <div class="ad-description-section">
                    <h2 class="section-title">Описание</h2>
                    <div class="ad-description {{#if isDescriptionLong}}collapsed{{/if}}" id="adDescription">
                        <p>{{description}}</p>
                    </div>
                    {{#if isDescriptionLong}}
                    <button class="btn-show-more" data-action="toggle-description">
                        <span class="show-more-text">Показать полностью</span>
                        <span class="show-less-text" style="display: none;">Свернуть</span>
                    </button>
                    {{/if}}
                </div>

                <!-- ХАРАКТЕРИСТИКИ (2 колонки по 4 строки) -->
                <div class="ad-attributes-section">
                    <h2 class="section-title">Характеристики</h2>
                    <div class="attributes-grid">
                        {{#each attributes}}
                            <div class="attribute-item">
                                <span class="attribute-name">{{name}}:</span>
                                <span class="attribute-value">{{value}}</span>
                            </div>
                        {{/each}}
                    </div>
                </div>

                <!-- МЕСТОПОЛОЖЕНИЕ ПРОДАВЦА -->
                <div class="ad-location-section">
                    <h2 class="section-title">Местоположение</h2>
                    <div class="location-info">
                        <div class="location-details">
                            <div class="location-address">{{location}}</div>
                            <div class="seller-name">Продавец: {{sellerName}}</div>
                            <div class="seller-since">Зарегистрирован: {{sellerSince}}</div>
                        </div>
                    </div>
                </div>

                <div class="preview-actions">
                    <button type="button" class="btn-back-edit" data-action="back-to-edit"><span class="btn-back-edit__icon">{{{icon "arrow-left"}}}</span><span>Назад к редактированию</span></button>
                    <button type="button" class="btn-publish-final" data-action="publish-ad">Опубликовать объявление</button>
                </div>
            </div>
            
            <!-- Правая колонка с рекламой (3/12) -->
            <div class="ad-column">
                Рекламное место
            </div>
        </div>
    </main>
</div>
