<div id="priceHistoryModal" class="modal-overlay" style="display: none;">
    <div class="price-history-modal-content">
        <button class="price-history-modal-close" data-action="close-modal">&times;</button>
        
        <h3 class="price-history-title">История цены: <span class="price-history-ad-title"></span></h3>
        
        <div id="priceHistoryChartContainer" class="price-chart-wrapper"></div>
        
        <div class="price-history-stats">
            <div class="price-history-stats-grid">
                <div class="price-history-stat">
                    <span class="stat-label">Текущая цена</span>
                    <span class="stat-value current-price"></span>
                </div>
                <div class="price-history-stat extra-stat">
                    <span class="stat-label">Минимальная</span>
                    <span class="stat-value min-price"></span>
                    <span class="stat-date min-date"></span>
                </div>
                <div class="price-history-stat extra-stat">
                    <span class="stat-label">Максимальная</span>
                    <span class="stat-value max-price"></span>
                    <span class="stat-date max-date"></span>
                </div>
                <div class="price-history-stat extra-stat">
                    <span class="stat-label">Изменений</span>
                    <span class="stat-value changes-count"></span>
                </div>
                <div class="price-history-stat extra-stat">
                    <span class="stat-label">Изменений сегодня</span>
                    <span class="stat-value changes-today"></span>
                </div>
            </div>
        </div>
    </div>
</div>
