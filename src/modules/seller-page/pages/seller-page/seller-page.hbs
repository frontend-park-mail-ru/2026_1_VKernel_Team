<div class="main-container">
    {{> search-section}}

    <main class="main-content">
        <button class="btn-back seller-page-back" data-action="back" type="button" aria-label="Назад">{{{icon "arrow-left"}}}<span>Назад</span></button>

        <div class="seller-page-layout">
            <!-- Левая колонка -->
            <aside class="seller-sidebar">
                {{> seller-info-card seller=seller}}

                <div class="seller-ad-banner">
                    <span>Здесь будет реклама</span>
                </div>
            </aside>

            <!-- Правая колонка -->
            <section class="seller-ads-section">
                <h2 class="seller-ads-title">Объявления продавца</h2>

                {{> seller-tabs activeAdsCount=activeAdsCount closedAdsCount=closedAdsCount reviewsCount=reviewsCount}}

                <div class="seller-tab-content" data-tab-content="active">
                    {{#if activeAds.length}}
                        <div class="recommendations-row">
                            {{#each activeAds}}
                                {{> ad-card this showCartButton=../showCartButton}}
                            {{/each}}
                        </div>
                    {{else}}
                        <p class="seller-ads-empty">У продавца нет активных объявлений</p>
                    {{/if}}
                </div>

                <div class="seller-tab-content seller-tab-content--hidden" data-tab-content="closed">
                    {{#if closedAds.length}}
                        <div class="recommendations-row">
                            {{#each closedAds}}
                                {{> ad-card this}}
                            {{/each}}
                        </div>
                    {{else}}
                        <p class="seller-ads-empty">У продавца нет завершённых объявлений</p>
                    {{/if}}
                </div>

                <div class="seller-tab-content seller-tab-content--hidden" data-tab-content="reviews">
                    <div class="seller-reviews-layout">
                        <div class="seller-reviews-layout__summary" id="sellerReviewsSummary"></div>
                        <div class="seller-reviews-layout__list">
                            <div id="sellerReviewsCta"></div>
                            <div id="sellerReviewsList"></div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>
</div>
