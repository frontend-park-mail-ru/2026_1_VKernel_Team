<div class="cart-item" data-product-id="{{product_id}}">
    <a href="/ad/{{product_id}}" class="cart-item-image" data-nav="/ad/{{product_id}}">
        <img src="{{imageUrl}}" alt="{{title}}">
    </a>
    <div class="cart-item-info">
        <a href="/ad/{{product_id}}" class="cart-item-title" data-nav="/ad/{{product_id}}">{{title}}</a>
        <span class="cart-item-price">{{formattedPrice}}</span>
    </div>
    <div class="cart-item-delivery">
        <div class="cart-item-address">
            <span class="cart-item-address-label">Адрес:</span>
            <span class="cart-item-address-value">{{location}}</span>
        </div>
    </div>
    <div class="cart-item-actions">
        <button class="cart-item-message" data-message-seller-id="{{product_id}}" type="button">
            Написать продавцу
        </button>
        <button class="cart-item-delete" data-delete-id="{{product_id}}" type="button" title="Удалить из корзины">
            🗑
        </button>
    </div>
</div>
