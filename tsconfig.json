{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/js/*"],
      "@core/*": ["src/js/core/*"],
      "@api/*": ["src/js/api/*"],
      "@services/*": ["src/js/services/*"],
      "@controllers/*": ["src/js/controllers/*"],
      "@validators/*": ["src/js/validators/*"],
      "@utils/*": ["src/js/utils/*"],
      "@types": ["src/js/types"]
    },
    "outDir": "./src",
    "rootDir": "./src/js",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src/js/**/*"],
  "exclude": ["node_modules", "public", "dist"]
}
