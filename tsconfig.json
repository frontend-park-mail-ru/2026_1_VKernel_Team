{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",

    //"baseUrl": ".",
    "paths": {
      "@/*": ["./src/js/*"],
      "@templates/*": ["./src/templates/*"],
      "@css/*": ["./public/css/*"],
      "@core/*": ["./src/js/core/*"],
      "@api/*": ["./src/js/api/*"],
      "@services/*": ["./src/js/services/*"],
      "@controllers/*": ["./src/js/controllers/*"],
      "@validators/*": ["./src/js/validators/*"],
      "@utils/*": ["./src/js/utils/*"],
      "@types": ["./src/js/types"],
      "@modules/*": ["./src/modules/*"],
      "@assets/*": ["./src/assets/*"]
    },

    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,

    "noEmit": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/js/**/*",
    "src/**/*",
    "src/templates/**/*.hbs"
  ],
  "exclude": ["node_modules", "public", "dist"],
    "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}
